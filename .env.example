# Скопируйте в .env и заполните.
# Для GitHub Actions эти же значения кладите в repo Secrets, а НЕ сюда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Окно сбора новостей (в часах МСК, назад от момента запуска)
NEWS_WINDOW_HOURS=16

# HTTP
HTTP_TIMEOUT=20
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
